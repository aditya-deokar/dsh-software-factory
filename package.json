{
  "name": "dsh-software-factory",
  "version": "1.0.0",
  "description": "DeepSeek Harness plugin for the self-improving Software Factory: triage, spec, worktree isolation, test evidence, Greptile review loop, and autonomous outer loop.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "cordis.yml",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "cordis-plugin",
    "software-factory",
    "agent-skills",
    "code-review",
    "worktree",
    "test-evidence",
    "run-ledger",
    "agent-memory",
    "model-routing"
  ],
  "author": "Aditya Deokar",
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
